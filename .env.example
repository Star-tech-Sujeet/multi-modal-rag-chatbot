# ===================================================================
# Multi-Modal RAG Application - Environment Configuration
# ===================================================================
# Copy this file to .env and fill in your actual values
# The application will use these defaults if .env is not present

# ===================================================================
# 1. AI Provider Selection
# ===================================================================
# Active runtime provider: "gemini" (default) or "openai"
AI_PROVIDER=gemini

# ===================================================================
# 2. Google Gemini Configuration (Primary Runtime Provider)
# ===================================================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_PRO_MODEL=gemini-3.1-pro-preview
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_TOKENS=10000

# ===================================================================
# 3. OpenAI Configuration (Optional / Secondary Provider)
# ===================================================================
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
OPENAI_MINI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=10000

# ===================================================================
# Document Processing
# ===================================================================
CHUNK_SIZE=1000                        # Characters per document chunk
CHUNK_OVERLAP=200                      # Character overlap between chunks
MAX_FILE_SIZE_MB=50                    # Maximum upload file size in megabytes

# ===================================================================
# Storage Paths
# ===================================================================
CHROMA_DB_PATH=./data/chroma_db        # ChromaDB vector store directory
UPLOADS_PATH=./data/uploads            # Uploaded files storage directory

# ===================================================================
# API Server Configuration
# ===================================================================
API_HOST=0.0.0.0                       # API server bind address
API_PORT=8000                          # API server port
CORS_ORIGINS=*                         # Allowed CORS origins (comma-separated or *)

# ===================================================================
# Frontend Configuration
# ===================================================================
API_BASE_URL=http://localhost:8000/api/v1  # Backend API URL for frontend
REQUEST_TIMEOUT=60                     # HTTP request timeout in seconds
HEALTH_CHECK_TIMEOUT=5                 # Health check timeout in seconds

# ===================================================================
# RAG & Retrieval Tuning Configuration
# ===================================================================
FINAL_TOP_K=5                          # Final number of source chunks to retrieve (default: 5)
DEFAULT_MAX_SOURCES=5                  # Backward-compatible alias for FINAL_TOP_K
DEFAULT_TEMPERATURE=0.7                # Default LLM temperature
ENABLE_RERANKING=true                  # Whether to enable the lexical reranking stage (true/false)
VECTOR_CANDIDATES=20                   # Candidate chunks to retrieve from vector search (default: 20)
BM25_CANDIDATES=20                     # Candidate chunks to retrieve from BM25 search (default: 20)
RAG_GENERATE_SUGGESTED_QUESTIONS=false # Set to true to enable secondary LLM call for follow-up questions
ENABLE_PROCESSING_STATUS=true          # Enable real-time intelligent response pipeline status events

# ===================================================================
# Application Settings
# ===================================================================
DEBUG_MODE=false                       # Enable debug mode for verbose logging
ENVIRONMENT=development                # Environment identifier (development or production)